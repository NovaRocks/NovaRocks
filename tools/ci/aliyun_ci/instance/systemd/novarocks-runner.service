[Unit]
Description=NovaRocks one-job GitHub Runner
Requires=novarocks-ci-bootstrap.service
After=novarocks-ci-bootstrap.service network-online.target

[Service]
Type=simple
User=runner
Group=runner
WorkingDirectory=/opt/novarocks-ci
# Deny the unprivileged workload access to the bootstrap instance-role endpoint.
# Root bootstrap and spot watcher retain their metadata access.
ExecStartPre=+/usr/sbin/iptables -I OUTPUT -d 100.100.100.200/32 -m owner --uid-owner runner -j REJECT
# Only the launcher reads root-only JIT. It drops groups/gid/uid before run.sh.
ExecStart=+/opt/novarocks-ci/venv/bin/python -m aliyun_ci.instance.bootstrap --launch-runner
OOMPolicy=continue
KillMode=control-group
UMask=0027
Restart=no
