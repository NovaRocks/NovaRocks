# Copy to a deployment-specific path and start with:
# novarocks standalone --role fe --config ./novarocks-fe.toml

log_level = "info"

# Every deployable FE/BE configuration in one deployment must use the same
# deployment_id and shared secret. The secret is resolved by Server at startup;
# do not put a production secret in this file.
[native_trust]
deployment_id = "analytics-prod"
shared_secret = "${ENV:NOVAROCKS_NATIVE_SHARED_SECRET}"
# Omitting [native_trust.transport] selects authenticated plaintext h2c.
# See docs/guides/deployment/native-trust.md for optional TLS 1.3 modes.

[server]
host = "127.0.0.1"
# Native coordinator-report gRPC listener. This listener does not expose
# management HTTP routes.
grpc_port = 9080
# FE management HTTP listener for FE-scoped metrics and gated lifecycle debug.
http_port = 8040
# These FE-only bounds reserve 300s for admitted work and 30s for final
# teardown after SIGTERM.
frontend_drain_timeout_ms = 300000
frontend_cleanup_timeout_ms = 30000

[cluster]
role = "fe"
# Backend desired lifecycle belongs to the external orchestrator. Each BE
# announces itself to this FE endpoint; FE keeps only an in-memory observed
# eligibility projection. SQL ADD/DROP BACKEND and cluster.backends are not
# supported configuration or management surfaces.

# This example uses one immutable catalog desired-state snapshot. Copy this
# file together with novarocks-catalogs.toml.example and keep the relative path.
# Use mode = "dynamic-state-store" instead when SQL CREATE/DROP CATALOG must be
# the catalog authority; StateStore presence never selects that mode implicitly.
[catalog_source]
mode = "static-file"
static_file_path = "novarocks-catalogs.toml"

[state_store]
provider = "sqlite"
cluster_id = "production-cluster"
path = "meta/frontend-state.sqlite"

[state_store.history_retention]
max_age_secs = 604800
max_change_rows = 1000000
max_commit_receipts = 1000000
maintenance_interval_commits = 256
incremental_vacuum_pages = 1024

[runtime]
# TaskUpdate treats only typed unknown-outcome network failures as retryable.
query_control_task_update_rpc_timeout_ms = 5000
query_control_task_update_retry_error_duration_ms = 30000
query_control_task_update_retry_initial_backoff_ms = 100
query_control_task_update_retry_max_backoff_ms = 1000

# The FE Native listener shares these transport runtime settings with the BE
# listener. Task ingress capacities below use their validated defaults on FE.
[runtime.native_ingress]
worker_threads = 8
max_blocking_threads = 64

[standalone_server]
mysql_port = 9030
trino_port = 8080
trino_client_timeout_ms = 300000
user = "root"

[connector.object_store]
endpoint = "http://10.0.0.20:9000"
access_key_id = "${ENV:AWS_S3_ACCESS_KEY_ID}"
access_key_secret = "${ENV:AWS_S3_SECRET_ACCESS_KEY}"
region = "us-east-1"
enable_path_style_access = true

[runtime.frontend_constant_policy]
# Frozen compiled-package constant policy (ADR-0185); no deployment override.
max_rows = 4096
max_array_nodes = 4096
max_logical_elements = 65536
max_retained_buffer_bytes = 8388608
max_type_depth = 64
max_type_nodes = 4096
max_dictionary_depth = 8
max_metadata_bytes = 65536
max_library_validation_work = 33554432
max_library_validation_bytes = 33554432
