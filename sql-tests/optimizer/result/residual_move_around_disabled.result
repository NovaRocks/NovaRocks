Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
8:PROJECT [a.payload AS payload, b.payload AS payload, c.payload AS payload] stats={rows=506250000}
  7:HASH JOIN (BROADCAST, INNER, eq: [b.k = c.k]) bcast_verdict=feasible stats={rows=506250000}
    build runtime filters:
    - filter_id = 1, build_expr = (c.k)
    4:HASH JOIN (BROADCAST, INNER, eq: [a.k = b.k]) bcast_verdict=feasible stats={rows=506250000}
      build runtime filters:
      - filter_id = 0, build_expr = (b.k)
      1:SCAN db_sqlt_ae6738d71862e6e7.residual_mad_a (alias=a) stats={rows=22500}
           TABLE: db_sqlt_ae6738d71862e6e7.residual_mad_a
           columns: k, payload
           min-max stats
           predicates: CAST(a.k AS Int64) = 7 AND a.k IS NOT NULL
          probe runtime filters:
          - filter_id = 0, probe_expr = (a.k)
      3:GATHER stats={rows=90000}
    6:GATHER stats={rows=90000}
