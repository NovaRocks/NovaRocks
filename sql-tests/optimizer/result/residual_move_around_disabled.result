        BROADCAST EXCHANGE stats={rows=22500}
          SCAN db_sqlt_ae6738d71862e6e7.residual_mad_b (alias=b) stats={rows=22500}
               TABLE: db_sqlt_ae6738d71862e6e7.residual_mad_b
               columns: k, payload
               min-max stats
               predicates: b.k = 7 AND b.k IS NOT NULL
      BROADCAST EXCHANGE stats={rows=90000}
        SCAN db_sqlt_ae6738d71862e6e7.residual_mad_c (alias=c) stats={rows=90000}
             TABLE: db_sqlt_ae6738d71862e6e7.residual_mad_c
