    HASH JOIN (BROADCAST, INNER, eq: [b.k = c.k]) stats={rows=126562500}
      build runtime filters:
      - filter_id = 1, build_expr = (c.k)
      HASH JOIN (BROADCAST, INNER, eq: [a.k = b.k]) stats={rows=126562500}
        build runtime filters:
        - filter_id = 0, build_expr = (b.k)
        SCAN db_sqlt_ae6738d71862e6e7.residual_mad_a (alias=a) stats={rows=22500}
             TABLE: db_sqlt_ae6738d71862e6e7.residual_mad_a
             columns: k, payload
             min-max stats
             predicates: a.k = 7 AND a.k IS NOT NULL
            probe runtime filters:
