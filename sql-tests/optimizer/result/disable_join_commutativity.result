-- query 10
Explain String
GATHER EXCHANGE stats={rows=16200}
  PROJECT [lo.lo_orderkey AS lo_orderkey, d.d_year AS d_year] stats={rows=16200}
    HASH JOIN (BROADCAST, INNER, eq: [lo.lo_datekey = d.d_datekey]) stats={rows=16200}
      build runtime filters:
      - filter_id = 0, build_expr = (d.d_datekey)
      SCAN db_sqlt_113e43a4caf4f95c.lineorder (alias=lo) stats={rows=18000}
           TABLE: db_sqlt_113e43a4caf4f95c.lineorder
           columns: lo_orderkey, lo_datekey
           min-max stats
           predicates: lo.lo_datekey IS NOT NULL
          probe runtime filters:
          - filter_id = 0, probe_expr = (lo.lo_datekey)
      BROADCAST EXCHANGE stats={rows=2}
        SCAN db_sqlt_113e43a4caf4f95c.date_dim (alias=d) stats={rows=2}
             TABLE: db_sqlt_113e43a4caf4f95c.date_dim
             columns: d_datekey, d_year
             min-max stats
             predicates: d.d_datekey IS NOT NULL

