Explain String
GATHER EXCHANGE stats={rows=10}
  PROJECT [a.k AS k, sum(a.v + b.w) AS s] stats={rows=10}
    HASH AGGREGATE (GLOBAL, group by: [a.k]) stats={rows=10}
      aggregations: sum(a.v + b.w)
      HASH AGGREGATE (LOCAL, group by: [a.k]) stats={rows=10}
        aggregations: sum(a.v + b.w)
        HASH JOIN (BROADCAST, INNER, eq: [a.k = b.k]) stats={rows=1000000000}
          SCAN db_sqlt_0b6aab1d126fd201.g3_pt_a (alias=a) stats={rows=100000}
               TABLE: db_sqlt_0b6aab1d126fd201.g3_pt_a
               columns: k, v
               min-max stats
               predicates: a.v > 0
          GATHER EXCHANGE stats={rows=100000}
            SCAN db_sqlt_0b6aab1d126fd201.g3_pt_b (alias=b) stats={rows=100000}
                 TABLE: db_sqlt_0b6aab1d126fd201.g3_pt_b
