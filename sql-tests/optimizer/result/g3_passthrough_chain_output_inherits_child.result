Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
8:PROJECT [a.k AS k, sum(a.v + b.w) AS s] stats={rows=2}
  7:HASH AGGREGATE (GLOBAL, group by: [a.k]) stats={rows=2}
    aggregations: sum(a.v + b.w)
    6:HASH EXCHANGE stats={rows=2}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: HASH_PARTITIONED (a.k)
5:HASH AGGREGATE (LOCAL, group by: [a.k]) stats={rows=2}
  aggregations: sum(a.v + b.w)
  4:HASH JOIN (BROADCAST, INNER, eq: [b.k = a.k]) stats={rows=2}
    build runtime filters:
    - filter_id = 0, build_expr = (a.k)
    1:SCAN db_sqlt_0b6aab1d126fd201.g3_pt_b (alias=b) stats={rows=2}
         TABLE: db_sqlt_0b6aab1d126fd201.g3_pt_b
         columns: k, w
         min-max stats
         predicates: b.k IS NOT NULL
        probe runtime filters:
        - filter_id = 0, probe_expr = (b.k)
    3:GATHER stats={rows=2}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: UNPARTITIONED
2:SCAN db_sqlt_0b6aab1d126fd201.g3_pt_a (alias=a) stats={rows=2}
     TABLE: db_sqlt_0b6aab1d126fd201.g3_pt_a
     columns: k, v
     min-max stats
     predicates: a.v > 0 AND a.k IS NOT NULL
