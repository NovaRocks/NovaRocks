-- query 8
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
12:PROJECT [id, sum(score) AS total_score] stats={rows=1}
  11:MERGING-EXCHANGE stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 11
    PARTITION: UNPARTITIONED
10:LOCAL TOP-N (limit=1, offset=0) [sum(score) DESC NULLS LAST] stats={rows=1}
  9:HASH AGGREGATE (GLOBAL, group by: [id]) stats={rows=10}
    aggregations: sum(score)
    8:HASH EXCHANGE stats={rows=10}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 8
    PARTITION: HASH_PARTITIONED (id)
7:HASH AGGREGATE (LOCAL, group by: [id]) stats={rows=10}
  aggregations: sum(score)
  6:PROJECT [id, score] stats={rows=200000}
    5:UNION ALL stats={rows=200000}
      2:PROJECT [id, score] stats={rows=100000}
        1:SCAN db_sqlt_70295c213242fcf5.topn_compactness_left_src stats={rows=100000}
             TABLE: db_sqlt_70295c213242fcf5.topn_compactness_left_src
             columns: id, score
             min-max stats
      4:PROJECT [id, score] stats={rows=100000}
        3:SCAN db_sqlt_70295c213242fcf5.topn_compactness_right_src stats={rows=100000}
             TABLE: db_sqlt_70295c213242fcf5.topn_compactness_right_src
             columns: id, score
             min-max stats
