  TOP-N (limit=1) [sum(score) DESC NULLS LAST] stats={rows=1}
    LOCAL TOP-N (limit=1, offset=0) [sum(score) DESC NULLS LAST] stats={rows=1}
      HASH AGGREGATE (GLOBAL, group by: [id]) stats={rows=6325}
        aggregations: sum(score)
        HASH EXCHANGE (source: ShuffleAgg, hash: [c9]) stats={rows=6325}
          HASH AGGREGATE (LOCAL, group by: [id]) stats={rows=6325}
            aggregations: sum(score)
