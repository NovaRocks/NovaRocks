    aggregations: count()
    GATHER EXCHANGE stats={rows=1}
      HASH AGGREGATE (LOCAL) stats={rows=1}
        aggregations: count()
        HASH JOIN (BROADCAST, INNER, eq: [b.k = w_alias.k]) stats={rows=3}
          build runtime filters:
          - filter_id = 0, build_expr = (w_alias.k)
          SCAN db_sqlt_73474ac5ba7b3917.oq6_alias_base (alias=b) stats={rows=3}
               TABLE: db_sqlt_73474ac5ba7b3917.oq6_alias_base
               columns: k
               min-max stats
               predicates: b.k IS NOT NULL
              probe runtime filters:
              - filter_id = 0, probe_expr = (b.k)
          BROADCAST EXCHANGE stats={rows=3}
            FILTER stats={rows=3}
              predicate: w_alias.k IS NOT NULL
              PROJECT [k, v] stats={rows=3}
                PROJECT [k, v] stats={rows=3}
                  SCAN db_sqlt_73474ac5ba7b3917.oq6_alias_base stats={rows=3}
