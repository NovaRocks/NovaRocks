    aggregations: count()
    GATHER EXCHANGE stats={rows=1}
      HASH AGGREGATE (LOCAL) stats={rows=1}
        aggregations: count()
        HASH JOIN (BROADCAST, INNER, eq: [b.k = w_alias.k]) stats={rows=405000000}
          build runtime filters:
