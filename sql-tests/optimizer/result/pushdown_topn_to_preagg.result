  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 12
    PARTITION: UNPARTITIONED
11:LOCAL TOP-N (limit=10, offset=0) [city ASC NULLS FIRST] stats={rows=10}
  10:PROJECT [city, sum(sales)] stats={rows=10}
    9:HASH AGGREGATE (GLOBAL, group by: [city]) stats={rows=10}
      aggregations: sum(sales)
      8:HASH EXCHANGE stats={rows=10}
