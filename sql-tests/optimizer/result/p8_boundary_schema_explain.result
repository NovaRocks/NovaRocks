  PROJECT [k, sum(v) AS total_v] stats={rows=2}
    HASH AGGREGATE (GLOBAL, group by: [k]) stats={rows=2}
      aggregations: sum(v)
      HASH EXCHANGE (source: ShuffleAgg, hash: [c5]) stats={rows=2}
        HASH AGGREGATE (LOCAL, group by: [k]) stats={rows=2}
          aggregations: sum(v)
          PROJECT [k, v] stats={rows=2}
            UNION ALL stats={rows=2}
              PROJECT [1 AS k, 10 AS v] stats={rows=1}
                VALUES (1 rows) stats={rows=1}
              PROJECT [1 AS k, 20 AS v] stats={rows=1}
                VALUES (1 rows) stats={rows=1}
