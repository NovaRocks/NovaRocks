Explain String
GATHER EXCHANGE stats={rows=1250000000}
  PROJECT [l.k AS k, r.k AS k] stats={rows=1250000000}
    HASH JOIN (BROADCAST, LEFT OUTER, eq: [l.k = r.k]) stats={rows=1250000000}
      other: l.flag = 1
      SCAN db_sqlt_bff9997550cead6c.residual_outer_l (alias=l) stats={rows=100000}
           TABLE: db_sqlt_bff9997550cead6c.residual_outer_l
           columns: k, flag
           min-max stats
      BROADCAST EXCHANGE stats={rows=100000}
        SCAN db_sqlt_bff9997550cead6c.residual_outer_r (alias=r) stats={rows=100000}
             TABLE: db_sqlt_bff9997550cead6c.residual_outer_r
             columns: k
             min-max stats
