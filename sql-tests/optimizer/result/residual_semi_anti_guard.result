-- query 5
Explain String
GATHER EXCHANGE stats={rows=17678}
  PROJECT [l.k AS k] stats={rows=17678}
    HASH JOIN (BROADCAST, LEFT SEMI, eq: [l.k = r.k, l.flag = r.flag]) stats={rows=17678}
      other: l.flag = 1
      build runtime filters:
      - filter_id = 0, build_expr = (r.k)
      - filter_id = 1, build_expr = (r.flag)
      SCAN db_sqlt_30e12a0be90ceeef.residual_sa_l (alias=l) stats={rows=100000}
           TABLE: db_sqlt_30e12a0be90ceeef.residual_sa_l
           columns: k, flag
           min-max stats
          probe runtime filters:
          - filter_id = 0, probe_expr = (l.k)
          - filter_id = 1, probe_expr = (l.flag)
      BROADCAST EXCHANGE stats={rows=81000}
        SCAN db_sqlt_30e12a0be90ceeef.residual_sa_r (alias=r) stats={rows=81000}
             TABLE: db_sqlt_30e12a0be90ceeef.residual_sa_r
             columns: k, flag
             min-max stats
             predicates: r.k IS NOT NULL AND r.flag IS NOT NULL

-- query 6
Explain String
GATHER EXCHANGE stats={rows=40000}
  PROJECT [l.k AS k] stats={rows=40000}
    HASH JOIN (PARTITIONED, LEFT ANTI, eq: [l.k = r.k, l.flag = r.flag]) stats={rows=40000}
      other: l.flag = 1
      HASH EXCHANGE (source: ShuffleJoin, hash: [c1, c2]) stats={rows=100000}
        SCAN db_sqlt_30e12a0be90ceeef.residual_sa_l (alias=l) stats={rows=100000}
             TABLE: db_sqlt_30e12a0be90ceeef.residual_sa_l
             columns: k, flag
             min-max stats
      HASH EXCHANGE (source: ShuffleJoin, hash: [c4, c5]) stats={rows=100000}
        SCAN db_sqlt_30e12a0be90ceeef.residual_sa_r (alias=r) stats={rows=100000}
             TABLE: db_sqlt_30e12a0be90ceeef.residual_sa_r
             columns: k, flag
             min-max stats
