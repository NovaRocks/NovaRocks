-- query 5
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
5:PROJECT [l.k AS k] stats={rows=17678}
  4:HASH JOIN (BROADCAST, LEFT SEMI, eq: [l.k = r.k, l.flag = r.flag]) bcast_verdict=feasible stats={rows=17678}
    other: CAST(l.flag AS Int64) = 1
    build runtime filters:
    - filter_id = 0, build_expr = (r.k)
    - filter_id = 1, build_expr = (r.flag)
    1:SCAN db_sqlt_30e12a0be90ceeef.residual_sa_l (alias=l) stats={rows=100000}
         TABLE: db_sqlt_30e12a0be90ceeef.residual_sa_l
         columns: k, flag
         min-max stats
        probe runtime filters:
        - filter_id = 0, probe_expr = (l.k)
        - filter_id = 1, probe_expr = (l.flag)
    3:GATHER stats={rows=81000}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: UNPARTITIONED
2:SCAN db_sqlt_30e12a0be90ceeef.residual_sa_r (alias=r) stats={rows=81000}
     TABLE: db_sqlt_30e12a0be90ceeef.residual_sa_r
     columns: k, flag
     min-max stats
     predicates: r.k IS NOT NULL AND r.flag IS NOT NULL

