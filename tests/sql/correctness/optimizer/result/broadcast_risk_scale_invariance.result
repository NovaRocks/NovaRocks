-- query 18
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 4, expr = (b.k)
    consumer binding 1, fragment = 1, node = 5, expr = (p.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [count(*)] stats={rows=1}
  1:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count(*)
    2:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: UNPARTITIONED
3:HASH AGGREGATE (LOCAL) stats={rows=1}
  aggregations: count()
  4:HASH JOIN (BROADCAST, INNER, eq: [p.k = b.k]) bcast_verdict=feasible stats={rows=9000}
    5:SCAN ${case_db}.probe_1x (alias=p) stats={rows=90000}
         TABLE: ${case_db}.probe_1x
         columns: k
         min-max stats
         predicates: p.k IS NOT NULL
    6:BROADCAST EXCHANGE stats={rows=9000}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: BROADCAST
7:SCAN ${case_db}.build_1x (alias=b) stats={rows=9000}
     TABLE: ${case_db}.build_1x
     columns: k
     min-max stats
     predicates: b.k IS NOT NULL

