Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 2, expr = (r.k)
    consumer binding 1, fragment = 1, node = 3, expr = (l.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=166}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [l.v, r.v] stats={rows=166}
  2:HASH JOIN (BROADCAST, INNER, eq: [l.k = r.k]) bcast_verdict=feasible stats={rows=166}
    3:SCAN ${case_db}.t_dnn_l (alias=l) stats={rows=166}
         TABLE: ${case_db}.t_dnn_l
         columns: k, v
         min-max stats
         predicates: l.k IS NOT NULL
    4:BROADCAST EXCHANGE stats={rows=166}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: BROADCAST
5:SCAN ${case_db}.t_dnn_r (alias=r) stats={rows=166}
     TABLE: ${case_db}.t_dnn_r
     columns: k, v
     min-max stats
     predicates: r.k IS NOT NULL
