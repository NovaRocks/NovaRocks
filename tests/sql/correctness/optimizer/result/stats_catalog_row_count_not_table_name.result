Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=3}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [payload] stats={rows=3}
  2:SCAN ${case_db}.misleading_sales_fact_dim_lineitem stats={rows=3}
       TABLE: ${case_db}.misleading_sales_fact_dim_lineitem
       columns: payload
       min-max stats
