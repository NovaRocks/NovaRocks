Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 2, node = 5, expr = (b.k)
    consumer binding 1, fragment = 3, node = 8, expr = (a.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=2}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (k)
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [k, b.w, rn] stats={rows=2}
  2:WINDOW [row_number()] stats={rows=2}
    partition by: [k ASC NULLS FIRST]
    order by: [v ASC NULLS FIRST]
    3:SORT BY [k ASC NULLS FIRST, v ASC NULLS FIRST] stats={rows=2}
      4:HASH EXCHANGE stats={rows=2}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([3,4])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (b.k)
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: HASH_PARTITIONED (k)
5:HASH JOIN (PARTITIONED, RIGHT OUTER, eq: [a.k = b.k]) stats={rows=2}
  6:HASH EXCHANGE
  7:HASH EXCHANGE
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: HASH_PARTITIONED (a.k)
8:SCAN ${case_db}.g3_ro_left (alias=a) stats={rows=2}
     TABLE: ${case_db}.g3_ro_left
     columns: k, v, _file, _pos
     min-max stats
PLAN FRAGMENT 4
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 7
    PARTITION: HASH_PARTITIONED (b.k)
9:SCAN ${case_db}.date_dim (alias=b) stats={rows=2}
     TABLE: ${case_db}.date_dim
     columns: k, w, _file, _pos
     min-max stats
