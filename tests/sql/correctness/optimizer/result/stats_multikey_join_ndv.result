Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 2, node = 5, expr = (r.k1)
    consumer binding 1, fragment = 2, node = 6, expr = (l.k1), activation = BlockingSnapshot
  runtime filter channel 2
    producer binding 2, fragment = 2, node = 5, expr = (r.k2)
    consumer binding 2, fragment = 2, node = 6, expr = (l.k2), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=224}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (l.k1, l.k2)
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [l.k1, l.k2, count(*)] stats={rows=224}
  2:HASH AGGREGATE (GLOBAL, group by: [l.k1, l.k2]) stats={rows=224}
    aggregations: count(*)
    3:HASH EXCHANGE stats={rows=224}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: HASH_PARTITIONED (l.k1, l.k2)
4:HASH AGGREGATE (LOCAL, group by: [l.k1, l.k2]) stats={rows=224}
  aggregations: count()
  5:HASH JOIN (BROADCAST, INNER, eq: [l.k1 = r.k1, l.k2 = r.k2]) bcast_verdict=feasible stats={rows=293}
    6:SCAN ${case_db}.oq12_stats_mj_l (alias=l) stats={rows=810}
         TABLE: ${case_db}.oq12_stats_mj_l
         columns: k1, k2
         min-max stats
         predicates: l.k1 IS NOT NULL AND l.k2 IS NOT NULL
    7:BROADCAST EXCHANGE stats={rows=81}
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 7
    PARTITION: BROADCAST
8:SCAN ${case_db}.oq12_stats_mj_r (alias=r) stats={rows=81}
     TABLE: ${case_db}.oq12_stats_mj_r
     columns: k1, k2
     min-max stats
     predicates: r.k1 IS NOT NULL AND r.k2 IS NOT NULL
