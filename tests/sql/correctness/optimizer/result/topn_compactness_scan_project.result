-- query 4
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [id, score] stats={rows=2}
  1:PROJECT [id, score] stats={rows=2}
    2:TOP-N (limit=2, offset=0) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
      3:GATHER
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: UNPARTITIONED
4:LOCAL TOP-N (limit=2, offset=0) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
  5:PROJECT [id, score] stats={rows=3}
    6:SCAN ${case_db}.topn_compactness_project_src stats={rows=3}
         TABLE: ${case_db}.topn_compactness_project_src
         columns: id, score
         min-max stats

-- query 6
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:TOP-N (limit=2, offset=0) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
  1:GATHER
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 1
    PARTITION: UNPARTITIONED
2:LOCAL TOP-N (limit=2, offset=0) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
  3:PROJECT [id, score] stats={rows=3}
    4:PROJECT [id, score] stats={rows=3}
      5:PROJECT [id, score] stats={rows=3}
        6:SCAN ${case_db}.topn_compactness_project_src stats={rows=3}
             TABLE: ${case_db}.topn_compactness_project_src
             columns: id, score
             min-max stats
