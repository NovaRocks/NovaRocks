-- query 1
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [id, score] stats={rows=2}
  1:PROJECT [id, score] stats={rows=2}
    2:PROJECT [id, score] stats={rows=2}
      3:PROJECT [id, score] stats={rows=2}
        4:TOP-N (limit=2, offset=0) [score DESC NULLS LAST, id ASC NULLS FIRST] stats={rows=2}
          5:GATHER
