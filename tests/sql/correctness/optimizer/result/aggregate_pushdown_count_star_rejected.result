Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 4, expr = (b.k)
    consumer binding 1, fragment = 1, node = 5, expr = (a.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [count(*)] stats={rows=1}
  1:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count(*)
    2:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: UNPARTITIONED
3:HASH AGGREGATE (LOCAL) stats={rows=1}
  aggregations: count()
  4:HASH JOIN (BROADCAST, INNER, eq: [a.k = b.k]) bcast_verdict=feasible stats={rows=1}
    5:SCAN ${case_db}.t_agg_pd_neg_a (alias=a) stats={rows=2}
         TABLE: ${case_db}.t_agg_pd_neg_a
         columns: k
         min-max stats
         predicates: a.k IS NOT NULL
    6:BROADCAST EXCHANGE stats={rows=1}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: BROADCAST
7:SCAN ${case_db}.t_agg_pd_neg_b (alias=b) stats={rows=1}
     TABLE: ${case_db}.t_agg_pd_neg_b
     columns: k
     min-max stats
     predicates: b.k IS NOT NULL
