Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 2, expr = (l.k)
    consumer binding 1, fragment = 1, node = 3, expr = (r.k), activation = BlockingSnapshot
  runtime filter channel 2
    producer binding 2, fragment = 1, node = 2, expr = (l.score)
    consumer binding 2, fragment = 1, node = 3, expr = (r.score), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=11212646}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [l.payload, r.payload] stats={rows=11212646}
  2:HASH JOIN (BROADCAST, INNER, eq: [r.k = l.k, r.score = l.score]) bcast_verdict=feasible stats={rows=11212646}
    3:SCAN ${case_db}.residual_rng_r (alias=r) stats={rows=20250}
         TABLE: ${case_db}.residual_rng_r
         columns: k, score, payload
         min-max stats
         predicates: CAST(r.score AS Int64) BETWEEN 10 AND 40 AND r.k IS NOT NULL AND r.score IS NOT NULL
    4:BROADCAST EXCHANGE stats={rows=8859}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: BROADCAST
5:SCAN ${case_db}.residual_rng_l (alias=l) stats={rows=8859}
     TABLE: ${case_db}.residual_rng_l
     columns: k, score, payload
     min-max stats
     predicates: CAST(l.score AS Int64) BETWEEN 10 AND 40 AND CAST(l.score AS Int64) BETWEEN 10 AND 20 OR CAST(l.score AS Int64) BETWEEN 30 AND 40 AND l.k IS NOT NULL AND l.score IS NOT NULL
