Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=800}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [l.v] stats={rows=800}
  2:HASH JOIN (BROADCAST, LEFT ANTI, eq: [l.k = r.k]) bcast_verdict=feasible stats={rows=800}
    3:SCAN ${case_db}.t_dnn_al (alias=l) stats={rows=2000}
         TABLE: ${case_db}.t_dnn_al
         columns: k, v
         min-max stats
    4:BROADCAST EXCHANGE stats={rows=2000}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: BROADCAST
5:SCAN ${case_db}.t_dnn_ar (alias=r) stats={rows=2000}
     TABLE: ${case_db}.t_dnn_ar
     columns: k
     min-max stats
