Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=20}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [b] stats={rows=20}
  2:SCAN ${case_db}.oq12_stats_or stats={rows=20}
       TABLE: ${case_db}.oq12_stats_or
       columns: a, b
       min-max stats
       predicates: CAST(a AS Int64) = 1 OR CAST(a AS Int64) = 2
