-- query 11
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 4, expr = (b.k)
    consumer binding 1, fragment = 2, node = 7, expr = (p.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [count(*)] stats={rows=1}
  1:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count(*)
    2:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2,3])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: UNPARTITIONED
3:HASH AGGREGATE (LOCAL) stats={rows=1}
  aggregations: count()
  4:HASH JOIN (PARTITIONED, INNER, eq: [p.k = b.k]) stats={rows=4}
    5:HASH EXCHANGE
    6:HASH EXCHANGE
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 5
    PARTITION: HASH_PARTITIONED (p.k)
7:SCAN ${case_db}.pir8_rf_probe (alias=p) stats={rows=4}
     TABLE: ${case_db}.pir8_rf_probe
     columns: k
     min-max stats
     predicates: p.k IS NOT NULL
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: HASH_PARTITIONED (b.k)
8:SCAN ${case_db}.pir8_rf_build (alias=b) stats={rows=4}
     TABLE: ${case_db}.pir8_rf_build
     columns: k
     min-max stats
     predicates: b.k IS NOT NULL
