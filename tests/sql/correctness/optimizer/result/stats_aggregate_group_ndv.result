Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=63}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (a, b)
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [a, b, sum(v)] stats={rows=63}
  2:HASH AGGREGATE (GLOBAL, group by: [a, b]) stats={rows=63}
    aggregations: sum(v)
    3:HASH EXCHANGE stats={rows=63}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: HASH_PARTITIONED (a, b)
4:HASH AGGREGATE (LOCAL, group by: [a, b]) stats={rows=63}
  aggregations: sum(v)
  5:SCAN ${case_db}.oq12_stats_group stats={rows=1000}
       TABLE: ${case_db}.oq12_stats_group
       columns: a, b, v
       min-max stats
