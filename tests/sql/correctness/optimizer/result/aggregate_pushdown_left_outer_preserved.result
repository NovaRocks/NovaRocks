Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 4, expr = (a.k)
    consumer binding 1, fragment = 3, node = 10, expr = (b.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [a.k, sum(sum(a.v))] stats={rows=50}
  1:PROJECT [a.k, sum(sum(a.v))] stats={rows=50}
    2:HASH AGGREGATE (SINGLE, group by: [a.k]) stats={rows=50}
      aggregations: sum(sum(a.v))
      3:GATHER stats={rows=100}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2,3])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (a.k)
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: UNPARTITIONED
4:HASH JOIN (PARTITIONED, RIGHT OUTER, eq: [b.k = a.k]) stats={rows=100}
  5:HASH EXCHANGE
  6:HASH AGGREGATE (GLOBAL, group by: [a.k]) stats={rows=100}
    aggregations: sum(a.v)
    7:HASH EXCHANGE stats={rows=100}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 7
    PARTITION: HASH_PARTITIONED (a.k)
8:HASH AGGREGATE (LOCAL, group by: [a.k]) stats={rows=100}
  aggregations: sum(a.v)
  9:SCAN ${case_db}.t_agg_pd_lo_a (alias=a) stats={rows=20000}
       TABLE: ${case_db}.t_agg_pd_lo_a
       columns: k, v
       min-max stats
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 5
    PARTITION: HASH_PARTITIONED (b.k)
10:SCAN ${case_db}.t_agg_pd_lo_b (alias=b) stats={rows=50}
     TABLE: ${case_db}.t_agg_pd_lo_b
     columns: k
     min-max stats
