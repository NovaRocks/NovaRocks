Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 2, expr = (b.k)
    consumer binding 1, fragment = 1, node = 3, expr = (a.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=2}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [a.k, a.v, b.w] stats={rows=2}
  2:HASH JOIN (BROADCAST, INNER, eq: [a.k = b.k]) bcast_verdict=feasible stats={rows=2}
    3:SCAN ${case_db}.t_optimizer_baseline_a (alias=a) stats={rows=2}
         TABLE: ${case_db}.t_optimizer_baseline_a
         columns: k, v
         min-max stats
         predicates: a.k IS NOT NULL
    4:BROADCAST EXCHANGE stats={rows=2}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: BROADCAST
5:SCAN ${case_db}.t_optimizer_baseline_b (alias=b) stats={rows=2}
     TABLE: ${case_db}.t_optimizer_baseline_b
     columns: k, w
     min-max stats
     predicates: b.k IS NOT NULL
