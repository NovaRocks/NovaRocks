Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [count(*)] stats={rows=1}
  1:HASH AGGREGATE (SINGLE) stats={rows=1}
    aggregations: count()
    2:NEST LOOP JOIN (CROSS) stats={rows=10000}
      3:GATHER stats={rows=100}
      4:GATHER stats={rows=100}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: UNPARTITIONED
5:SCAN ${case_db}.oq12_stats_big_a (alias=a) stats={rows=100}
     TABLE: ${case_db}.oq12_stats_big_a
     columns: k
     min-max stats
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: UNPARTITIONED
6:SCAN ${case_db}.oq12_stats_big_b (alias=b) stats={rows=100}
     TABLE: ${case_db}.oq12_stats_big_b
     columns: k
     min-max stats
