Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 2, node = 6, expr = (b.k)
    consumer binding 1, fragment = 2, node = 7, expr = (a.k), activation = BlockingSnapshot
  runtime filter channel 2
    producer binding 2, fragment = 2, node = 5, expr = (s.s)
    consumer binding 2, fragment = 2, node = 7, expr = (a.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (a.k)
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [a.k, a.v, b.w, rn] stats={rows=1}
  2:WINDOW [row_number()] stats={rows=1}
    partition by: [a.k ASC NULLS FIRST]
    order by: [a.v ASC NULLS FIRST]
    3:SORT BY [a.k ASC NULLS FIRST, a.v ASC NULLS FIRST] stats={rows=1}
      4:HASH EXCHANGE stats={rows=1}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: HASH_PARTITIONED (a.k)
5:HASH JOIN (BROADCAST, INNER, eq: [a.k = s.s]) bcast_verdict=feasible stats={rows=1}
  6:HASH JOIN (BROADCAST, INNER, eq: [a.k = b.k]) bcast_verdict=feasible stats={rows=2}
    7:SCAN ${case_db}.g3_bj_left (alias=a) stats={rows=2}
         TABLE: ${case_db}.g3_bj_left
         columns: k, v, _file, _pos
         min-max stats
         predicates: a.k IS NOT NULL
    8:BROADCAST EXCHANGE stats={rows=2}
  9:BROADCAST EXCHANGE stats={rows=1}
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 8
    PARTITION: BROADCAST
10:SCAN ${case_db}.g3_bj_right (alias=b) stats={rows=2}
     TABLE: ${case_db}.g3_bj_right
     columns: k, w, _file, _pos
     min-max stats
     predicates: b.k IS NOT NULL
PLAN FRAGMENT 4
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 9
    PARTITION: BROADCAST
11:SCAN ${case_db}.g3_bj_small (alias=s) stats={rows=1}
     TABLE: ${case_db}.g3_bj_small
     columns: s, x, _file, _pos
     min-max stats
     predicates: s.s IS NOT NULL
