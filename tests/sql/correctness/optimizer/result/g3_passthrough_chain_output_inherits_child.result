Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 2, node = 5, expr = (a.k)
    consumer binding 1, fragment = 2, node = 6, expr = (b.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=2}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (a.k)
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [a.k, sum(a.v + b.w)] stats={rows=2}
  2:HASH AGGREGATE (GLOBAL, group by: [a.k]) stats={rows=2}
    aggregations: sum(a.v + b.w)
    3:HASH EXCHANGE stats={rows=2}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 3
    PARTITION: HASH_PARTITIONED (a.k)
4:HASH AGGREGATE (LOCAL, group by: [a.k]) stats={rows=2}
  aggregations: sum(a.v + b.w)
  5:HASH JOIN (BROADCAST, INNER, eq: [b.k = a.k]) bcast_verdict=feasible stats={rows=2}
    6:SCAN ${case_db}.g3_pt_b (alias=b) stats={rows=2}
         TABLE: ${case_db}.g3_pt_b
         columns: k, w
         min-max stats
         predicates: b.k IS NOT NULL
    7:BROADCAST EXCHANGE stats={rows=2}
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 7
    PARTITION: BROADCAST
8:SCAN ${case_db}.g3_pt_a (alias=a) stats={rows=2}
     TABLE: ${case_db}.g3_pt_a
     columns: k, v
     min-max stats
     predicates: CAST(a.v AS Int64) > 0 AND a.k IS NOT NULL
