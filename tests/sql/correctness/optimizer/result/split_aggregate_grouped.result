Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:SORT BY [k ASC NULLS FIRST] stats={rows=4}
  1:GATHER stats={rows=4}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (k)
  STREAM DATA SINK
    EXCHANGE ID: 1
    PARTITION: UNPARTITIONED
2:PROJECT [k, sum(v)] stats={rows=4}
  3:HASH AGGREGATE (GLOBAL, group by: [k]) stats={rows=4}
    aggregations: sum(v)
    4:HASH EXCHANGE stats={rows=4}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: HASH_PARTITIONED (k)
5:HASH AGGREGATE (LOCAL, group by: [k]) stats={rows=4}
  aggregations: sum(v)
  6:SCAN ${case_db}.t_split_agg_grouped stats={rows=12}
       TABLE: ${case_db}.t_split_agg_grouped
       columns: k, v
       min-max stats
