Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 2, node = 6, expr = (r.k)
    consumer binding 1, fragment = 2, node = 7, expr = (l.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:SORT BY [l.k ASC NULLS FIRST] stats={rows=3}
  1:GATHER stats={rows=3}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (l.k)
  STREAM DATA SINK
    EXCHANGE ID: 1
    PARTITION: UNPARTITIONED
2:PROJECT [l.k, sum(r.v)] stats={rows=3}
  3:HASH AGGREGATE (GLOBAL, group by: [l.k]) stats={rows=3}
    aggregations: sum(r.v)
    4:HASH EXCHANGE stats={rows=3}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: HASH_PARTITIONED (l.k)
5:HASH AGGREGATE (LOCAL, group by: [l.k]) stats={rows=3}
  aggregations: sum(r.v)
  6:HASH JOIN (BROADCAST, INNER, eq: [l.k = r.k]) bcast_verdict=feasible stats={rows=3}
    7:SCAN ${case_db}.oq8_reuse_l (alias=l) stats={rows=3}
         TABLE: ${case_db}.oq8_reuse_l
         columns: k
         min-max stats
         predicates: l.k IS NOT NULL
    8:BROADCAST EXCHANGE stats={rows=3}
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 8
    PARTITION: BROADCAST
9:SCAN ${case_db}.oq8_reuse_r (alias=r) stats={rows=3}
     TABLE: ${case_db}.oq8_reuse_r
     columns: k, v
     min-max stats
     predicates: r.k IS NOT NULL
