-- query 9
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=8000}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [l.k, flag] stats={rows=8000}
  2:HASH JOIN (BROADCAST, LEFT OUTER, eq: [l.k = r.k]) bcast_verdict=feasible stats={rows=8000}
    3:SCAN ${case_db}.oq12_stats_join_l (alias=l) stats={rows=1000}
         TABLE: ${case_db}.oq12_stats_join_l
         columns: k
         min-max stats
    4:BROADCAST EXCHANGE stats={rows=800}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: BROADCAST
5:SCAN ${case_db}.oq12_stats_join_r (alias=r) stats={rows=800}
     TABLE: ${case_db}.oq12_stats_join_r
     columns: k, flag
     min-max stats

-- query 10
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 2, expr = (r.k)
    consumer binding 1, fragment = 1, node = 3, expr = (l.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=1000}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [l.k] stats={rows=1000}
  2:HASH JOIN (BROADCAST, LEFT SEMI, eq: [l.k = r.k]) bcast_verdict=feasible stats={rows=1000}
    3:SCAN ${case_db}.oq12_stats_join_l (alias=l) stats={rows=1000}
         TABLE: ${case_db}.oq12_stats_join_l
         columns: k
         min-max stats
    4:BROADCAST EXCHANGE stats={rows=720}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: BROADCAST
5:SCAN ${case_db}.oq12_stats_join_r (alias=r) stats={rows=720}
     TABLE: ${case_db}.oq12_stats_join_r
     columns: k
     min-max stats
     predicates: r.k IS NOT NULL

