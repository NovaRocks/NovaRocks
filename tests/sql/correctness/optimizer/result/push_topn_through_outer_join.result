-- query 16
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 4, expr = (r.id)
    consumer binding 1, fragment = 1, node = 5, expr = (l.id), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:TOP-N (limit=5, offset=0) [l.score ASC NULLS FIRST] stats={rows=5}
  1:GATHER
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 1
    PARTITION: UNPARTITIONED
2:LOCAL TOP-N (limit=5, offset=0) [l.score ASC NULLS FIRST] stats={rows=5}
  3:PROJECT [l.id, l.score, r.payload] stats={rows=900}
    4:HASH JOIN (BROADCAST, INNER, eq: [l.id = r.id]) bcast_verdict=feasible stats={rows=900}
      5:SCAN ${case_db}.topn_outer_left (alias=l) stats={rows=90000}
           TABLE: ${case_db}.topn_outer_left
           columns: id, score
           min-max stats
           predicates: l.id IS NOT NULL
      6:BROADCAST EXCHANGE stats={rows=900}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: BROADCAST
7:SCAN ${case_db}.topn_outer_right (alias=r) stats={rows=900}
     TABLE: ${case_db}.topn_outer_right
     columns: id, payload
     min-max stats
     predicates: r.id IS NOT NULL
