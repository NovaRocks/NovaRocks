-- query 10
Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [l.id, l.score, payload] stats={rows=5}
  1:TOP-N (limit=5, offset=0) [l.score ASC NULLS FIRST] stats={rows=5}
    2:HASH JOIN (BROADCAST, LEFT OUTER, eq: [l.id = r.id]) bcast_verdict=feasible stats={rows=5}
      3:TOP-N (limit=5, offset=0) [l.score ASC NULLS FIRST] stats={rows=5}
        4:GATHER
      5:BROADCAST EXCHANGE stats={rows=1000}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: UNPARTITIONED
6:LOCAL TOP-N (limit=5, offset=0) [l.score ASC NULLS FIRST] stats={rows=5}
  7:SCAN ${case_db}.topn_outer_left (alias=l) stats={rows=100000}
       TABLE: ${case_db}.topn_outer_left
       columns: id, score
       min-max stats
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 5
    PARTITION: BROADCAST
8:SCAN ${case_db}.topn_outer_right (alias=r) stats={rows=1000}
     TABLE: ${case_db}.topn_outer_right
     columns: id, payload
     min-max stats

-- query 11
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 4, expr = (r.id)
    consumer binding 1, fragment = 2, node = 7, expr = (l.id), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:TOP-N (limit=5, offset=0) [r.payload DESC NULLS LAST] stats={rows=5}
  1:GATHER
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2,3])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 1
    PARTITION: UNPARTITIONED
2:LOCAL TOP-N (limit=5, offset=0) [r.payload DESC NULLS LAST] stats={rows=5}
  3:PROJECT [id, score, r.payload] stats={rows=1004}
    4:HASH JOIN (PARTITIONED, RIGHT OUTER, eq: [l.id = r.id]) stats={rows=1004}
      5:HASH EXCHANGE
      6:HASH EXCHANGE
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 5
    PARTITION: HASH_PARTITIONED (l.id)
7:SCAN ${case_db}.topn_outer_left (alias=l) stats={rows=100000}
     TABLE: ${case_db}.topn_outer_left
     columns: id, score
     min-max stats
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: HASH_PARTITIONED (r.id)
8:SCAN ${case_db}.topn_outer_right (alias=r) stats={rows=1000}
     TABLE: ${case_db}.topn_outer_right
     columns: id, payload
     min-max stats

