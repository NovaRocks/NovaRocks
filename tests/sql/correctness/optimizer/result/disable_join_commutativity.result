-- query 10
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 2, expr = (d.d_datekey)
    consumer binding 1, fragment = 1, node = 3, expr = (lo.lo_datekey), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=16200}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [lo.lo_orderkey, d.d_year] stats={rows=16200}
  2:HASH JOIN (BROADCAST, INNER, eq: [lo.lo_datekey = d.d_datekey]) bcast_verdict=feasible stats={rows=16200}
    3:SCAN ${case_db}.lineorder (alias=lo) stats={rows=18000}
         TABLE: ${case_db}.lineorder
         columns: lo_orderkey, lo_datekey
         min-max stats
         predicates: lo.lo_datekey IS NOT NULL
    4:BROADCAST EXCHANGE stats={rows=2}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: BROADCAST
5:SCAN ${case_db}.date_dim (alias=d) stats={rows=2}
     TABLE: ${case_db}.date_dim
     columns: d_datekey, d_year
     min-max stats
     predicates: d.d_datekey IS NOT NULL

