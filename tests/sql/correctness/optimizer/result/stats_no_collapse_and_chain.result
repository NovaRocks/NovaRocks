Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=2555}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [payload] stats={rows=2555}
  2:SCAN ${case_db}.oq12_stats_and_chain stats={rows=2555}
       TABLE: ${case_db}.oq12_stats_and_chain
       columns: c1, c2, c3, c4, c5, c6, payload
       min-max stats
       predicates: CAST(c1 AS Int64) BETWEEN 0 AND 80 AND CAST(c2 AS Int64) BETWEEN 0 AND 75 AND CAST(c3 AS Int64) BETWEEN 0 AND 65 AND CAST(c4 AS Int64) BETWEEN 0 AND 55 AND CAST(c5 AS Int64) BETWEEN 0 AND 45 AND CAST(c6 AS Int64) BETWEEN 0 AND 35
