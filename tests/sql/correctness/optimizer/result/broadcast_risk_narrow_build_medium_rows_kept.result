-- query 11
c1	c2
500000	500000

-- query 12
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 4, expr = (b.k)
    consumer binding 1, fragment = 1, node = 5, expr = (p.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [count(p.pad1), count(p.pad2)] stats={rows=1}
  1:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count(p.pad1), count(p.pad2)
    2:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: UNPARTITIONED
3:HASH AGGREGATE (LOCAL) stats={rows=1}
  aggregations: count(p.pad1), count(p.pad2)
  4:HASH JOIN (BROADCAST, INNER, eq: [p.k = b.k]) bcast_verdict=feasible stats={rows=450000}
    5:SCAN ${case_db}.probe_5m (alias=p) stats={rows=4500000}
         TABLE: ${case_db}.probe_5m
         columns: k, pad1, pad2
         min-max stats
         predicates: p.k IS NOT NULL
    6:BROADCAST EXCHANGE stats={rows=450000}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 6
    PARTITION: BROADCAST
7:SCAN ${case_db}.build_500k_int (alias=b) stats={rows=450000}
     TABLE: ${case_db}.build_500k_int
     columns: k
     min-max stats
     predicates: b.k IS NOT NULL
