-- query 15
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 7, expr = (a.k)
    consumer binding 1, fragment = 1, node = 8, expr = (b.k), activation = BlockingSnapshot
  runtime filter channel 2
    producer binding 2, fragment = 3, node = 14, expr = (c.k)
    consumer binding 2, fragment = 3, node = 15, expr = (d.k), activation = BlockingSnapshot
  runtime filter channel 3
    producer binding 3, fragment = 1, node = 4, expr = (c.v)
    consumer binding 3, fragment = 1, node = 4, expr = (a.v), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [count(*)] stats={rows=1}
  1:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count(*)
    2:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: UNPARTITIONED
3:HASH AGGREGATE (LOCAL) stats={rows=1}
  aggregations: count()
  4:HASH JOIN (BROADCAST, INNER, eq: [a.v = c.v]) bcast_verdict=feasible stats={rows=2}
    5:PROJECT [a.v] stats={rows=2}
      6:PROJECT [a.v] stats={rows=2}
        7:HASH JOIN (BROADCAST, INNER, eq: [b.k = a.k]) bcast_verdict=feasible stats={rows=2}
          8:SCAN ${case_db}.customer_demographics (alias=b) stats={rows=3}
               TABLE: ${case_db}.customer_demographics
               columns: k
               min-max stats
               predicates: b.k IS NOT NULL
          9:BROADCAST EXCHANGE stats={rows=2}
    10:BROADCAST EXCHANGE stats={rows=2}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 9
    PARTITION: BROADCAST
11:SCAN ${case_db}.ra (alias=a) stats={rows=2}
     TABLE: ${case_db}.ra
     columns: k, v
     min-max stats
     predicates: a.k IS NOT NULL AND a.v IS NOT NULL
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 10
    PARTITION: BROADCAST
12:PROJECT [c.v] stats={rows=2}
  13:PROJECT [c.v] stats={rows=2}
    14:HASH JOIN (BROADCAST, INNER, eq: [d.k = c.k]) bcast_verdict=feasible stats={rows=2}
      15:SCAN ${case_db}.customer_demographics (alias=d) stats={rows=3}
           TABLE: ${case_db}.customer_demographics
           columns: k
           min-max stats
           predicates: d.k IS NOT NULL
      16:BROADCAST EXCHANGE stats={rows=2}
PLAN FRAGMENT 4
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 16
    PARTITION: BROADCAST
17:SCAN ${case_db}.ra (alias=c) stats={rows=2}
     TABLE: ${case_db}.ra
     columns: k, v
     min-max stats
     predicates: c.k IS NOT NULL AND c.v IS NOT NULL

-- query 16
Explain String
RUNTIME FILTER GRAPH
  runtime filter channel 1
    producer binding 1, fragment = 1, node = 4, expr = (b.k)
    consumer binding 1, fragment = 1, node = 5, expr = (p.k), activation = BlockingSnapshot
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:PROJECT [count(*)] stats={rows=1}
  1:HASH AGGREGATE (GLOBAL) stats={rows=1}
    aggregations: count(*)
    2:GATHER stats={rows=1}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 2
    PARTITION: UNPARTITIONED
3:HASH AGGREGATE (LOCAL) stats={rows=1}
  aggregations: count()
  4:HASH JOIN (BROADCAST, INNER, eq: [p.k = b.k]) bcast_verdict=feasible stats={rows=3}
    5:SCAN ${case_db}.rf_x_probe (alias=p) stats={rows=90000}
         TABLE: ${case_db}.rf_x_probe
         columns: k
         min-max stats
         predicates: p.k IS NOT NULL
    6:BROADCAST EXCHANGE stats={rows=3}
