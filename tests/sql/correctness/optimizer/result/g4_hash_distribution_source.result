Explain String
PLAN FRAGMENT 0
  OUTPUT EXPRS: *
  STAGE PLACEMENT: singleton
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
0:GATHER stats={rows=2}
PLAN FRAGMENT 1
  OUTPUT EXPRS: *
  STAGE PLACEMENT: follow-sources([2])
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: HASH_PARTITIONED (l.k)
  STREAM DATA SINK
    EXCHANGE ID: 0
    PARTITION: UNPARTITIONED
1:PROJECT [l.k, l.v, w, rn] stats={rows=2}
  2:WINDOW [row_number()] stats={rows=2}
    partition by: [l.k ASC NULLS FIRST]
    order by: [l.v ASC NULLS FIRST]
    3:SORT BY [l.k ASC NULLS FIRST, l.v ASC NULLS FIRST] stats={rows=2}
      4:HASH EXCHANGE stats={rows=2}
PLAN FRAGMENT 2
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 4
    PARTITION: HASH_PARTITIONED (l.k)
5:HASH JOIN (BROADCAST, LEFT OUTER, eq: [l.k = r.k]) bcast_verdict=feasible stats={rows=2}
  6:SCAN ${case_db}.lineitem (alias=l) stats={rows=2}
       TABLE: ${case_db}.lineitem
       columns: k, v, _file, _pos
       min-max stats
  7:BROADCAST EXCHANGE stats={rows=2}
PLAN FRAGMENT 3
  OUTPUT EXPRS: *
  STAGE PLACEMENT: scan-work
  DRIVER DOMAIN: min=1, max=5, power-of-two=false
  PARTITION: UNPARTITIONED
  STREAM DATA SINK
    EXCHANGE ID: 7
    PARTITION: BROADCAST
8:SCAN ${case_db}.orders (alias=r) stats={rows=2}
     TABLE: ${case_db}.orders
     columns: k, w, _file, _pos
     min-max stats
