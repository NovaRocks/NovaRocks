# Declaration inputs only. Runtime service endpoints are allocated by the owner.
NOVA_ENV_SHARED_DOCKER=true
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
NOVA_ENV_SHARED_BENCHMARK_ROOT=s3://novarocks/shared/benchmarks
NOVA_ENV_BENCHMARK_BUILD_TIMEOUT_SECONDS=3600
NOVA_ENV_MYSQL_PORT_START=9030
NOVA_ENV_MYSQL_PORT_RANGE=199
NOVA_ENV_SPARK_VERSION=3.5.5-java17
NOVA_ENV_ICEBERG_VERSION=1.11.0
NOVA_ENV_RUNTIME_PORT_START=28000
NOVA_ENV_RUNTIME_PORT_END=28999
