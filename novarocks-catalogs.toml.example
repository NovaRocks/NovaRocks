# Immutable catalog desired-state snapshot for novarocks-fe.toml.example.
# Copy this file next to the FE config as novarocks-catalogs.toml. An explicit
# empty snapshot is valid; a missing or malformed file fails FE startup.
format_version = 1
catalogs = []

# Set these optional Iceberg defaults in the catalog's [catalogs.properties] table.
# "iceberg.max-partitions-per-writer" = "100"
# "iceberg.target-max-file-size" = "1GB"
# These are the defaults. A table's write.target-file-size-bytes overrides
# the file target. A catalog session can lower its open-partition cap with
# SET SESSION lake.max_partitions_per_writer = 32, where lake is the catalog.

# Opt in to ALTER TABLE EXECUTE add_files on this Iceberg catalog.
# The property is a string Boolean and defaults to "false".
# "iceberg.add-files-procedure.enabled" = "true"
