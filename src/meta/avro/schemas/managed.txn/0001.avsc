{
  "type": "record",
  "name": "StoredManagedTxn",
  "namespace": "novarocks.meta.managed",
  "fields": [
    { "name": "txn_id", "type": "long" },
    { "name": "table_id", "type": "long" },
    { "name": "partition_id", "type": "long" },
    { "name": "base_version", "type": "long" },
    { "name": "commit_version", "type": "long" },
    {
      "name": "state",
      "type": {
        "type": "enum",
        "name": "ManagedTxnState",
        "symbols": ["PREPARED", "WRITTEN", "VISIBLE", "ABORTED"]
      }
    },
    { "name": "retry_at_ms", "type": ["null", "long"], "default": null },
    { "name": "updated_at_ms", "type": "long" }
  ]
}
